# ==============================================================================
# AnalyzaX — Environment Configuration Template
# Copy this file to .env and provide your actual configuration values.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="AnalyzaX"
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY="generate-a-secure-random-secret-key-for-analyzax-sessions"

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVER (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. METADATA DATABASE (PostgreSQL)
# Note: Used strictly for metadata, lineage, user sessions, and job states.
# Not for primary storage of raw analytical datasets!
# ------------------------------------------------------------------------------
POSTGRES_USER=analyzax
POSTGRES_PASSWORD=analyzax_secure_password
POSTGRES_DB=analyzax_metadata
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://analyzax:analyzax_secure_password@localhost:5432/analyzax_metadata

# ------------------------------------------------------------------------------
# 4. STORAGE & DATA PATHS
# Relative to repository root or absolute paths on the host
# ------------------------------------------------------------------------------
DATA_STORAGE_ROOT="./data"
DATA_UPLOADS_DIR="./data/uploads"
DATA_PROCESSED_DIR="./data/processed"
DATA_EXPORTS_DIR="./data/exports"
DATA_TEMP_DIR="./data/temp"

# Maximum upload file size in megabytes (e.g., 500 MB)
MAX_UPLOAD_SIZE_MB=500

# ------------------------------------------------------------------------------
# 5. ANALYTICAL ENGINES (DuckDB / Polars)
# ------------------------------------------------------------------------------
DUCKDB_MEMORY_LIMIT="4GB"
DUCKDB_THREADS=4
DUCKDB_TEMP_DIRECTORY="./data/temp/duckdb"

# ------------------------------------------------------------------------------
# 6. ASYNCHRONOUS JOBS & TASK WORKER
# ------------------------------------------------------------------------------
ASYNC_TASK_BACKEND=local
# Options: 'local' (FastAPI BackgroundTasks for dev) or 'redis' (production Celery/ARQ)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. AI & LLM PROVIDER CONFIGURATION (Phase 13 AI Analyst)
# AnalyzaX uses a provider abstraction layer.
# Default options: 'mock' (offline testing/deterministic mode) or 'openrouter'
# (Do NOT commit your real API key!)
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY="your-openrouter-api-key-here"
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60
AI_MAX_TOOL_CALLS=8
AI_MAX_RETRIES=2
AI_MAX_ANALYSIS_SECONDS=120

# ------------------------------------------------------------------------------
# 8. FRONTEND (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AnalyzaX"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api/v1/ws"

# ------------------------------------------------------------------------------
# 9. AUTHENTICATION & SESSIONS (Phase 17)
# ------------------------------------------------------------------------------
AUTH_SESSION_SECRET="generate-a-secure-random-64-character-secret-key"
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_SESSION_TTL_SECONDS=604800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
